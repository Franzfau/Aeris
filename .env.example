# Application
NODE_ENV=development
PORT=3000
PUBLIC_API_URL=https://your-render-service.onrender.com
ALLOWED_ORIGINS=https://your-store.myshopify.com,https://your-custom-domain.ge

# Render PostgreSQL (Internal Database URL is preferred when both services are on Render)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Shopify custom app credentials. Do not use a legacy Admin API token.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=replace-with-new-client-id
SHOPIFY_CLIENT_SECRET=replace-with-new-client-secret
SHOPIFY_API_VERSION=2026-07

# Add only the bank that has supplied valid test/production credentials.
TBC_API_KEY=
TBC_API_SECRET=
TBC_MERCHANT_KEY=
TBC_CAMPAIGN_ID=
TBC_WEBHOOK_SECRET=

BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
BOG_WEBHOOK_SECRET=

CREDO_MERCHANT_ID=
CREDO_SECRET=
CREDO_WEBHOOK_SECRET=

KEEPZ_INTEGRATOR_ID=
KEEPZ_PUBLIC_KEY=
KEEPZ_PRIVATE_KEY=
KEEPZ_WEBHOOK_SECRET=
